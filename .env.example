# ── Telegram ──────────────────────────────────────────────────────────────
# Токен от @BotFather
TG_BOT_TOKEN=
# Ваш числовой Telegram ID (узнать: @userinfobot). Бот отвечает только ему.
TG_OWNER_ID=

# ── Банк ──────────────────────────────────────────────────────────────────
# Зеркало интернет-банка. ВТБ регулярно меняет домены.
#
# auto — подобрать живое зеркало самому (DNS + проверка браузером).
# Конкретный домен — работать только с ним и честно ругаться, если он умер.
#
# Учтите: при переезде на другое зеркало куки не переезжают вместе с ним,
# и в банк придётся зайти заново.
BANK_HOST=online.sbpvtb.ru

# Свой список кандидатов через запятую. Пусто — встроенный список из CSP
# самого банка. На 2026-08-13 из девяти доменов резолвились три:
# online.sbpvtb.ru, online.vtbsbp.ru, online.vneshtbank.ru
BANK_MIRRORS=

# ── Где крутимся ──────────────────────────────────────────────────────────
# local — макбук, окно браузера видно, логинимся руками
# vps   — сервер, окно под Xvfb (см. README)
RUNTIME=local

# Прятать окно браузера. Оставьте false: headless антифрод замечает.
HEADLESS=false

# Использовать установленный в системе браузер вместо скачиваемого Chromium:
# chrome или msedge. Сейчас это фактически обязательно — CDN Playwright отдаёт
# ошибку на загрузку сборок (см. README, раздел «Если что-то не поднялось»).
# Настоящий Chrome вдобавок выглядит для антифрода естественнее.
BROWSER_CHANNEL=chrome

# Профиль браузера с сессией банка. Не удалять между запусками — иначе банк
# каждый раз видит новое устройство.
PROFILE_DIR=./data/profile

# Прокси, если нужен: http://user:pass@host:port
PROXY=

LOCALE=ru-RU
TIMEZONE=Europe/Moscow

# ── Данные ────────────────────────────────────────────────────────────────
DB_PATH=./data/parserbank.db
ENDPOINTS_PATH=./endpoints.json
RECORD_DIR=./data/discovery

# ── Поведение ─────────────────────────────────────────────────────────────
# Как часто спрашивать банк. Минимум 15s, но не жадничайте: раз в минуту
# выглядит как живой человек, раз в 5 секунд — как бот.
#
# Максимум 2m, и это не про вежливость: ВТБ сбрасывает сессию после 3–5 минут
# бездействия, а опрос — единственное, что банк считает активностью. Реже —
# и бот сам себя разлогинит, а вход восстанавливается только руками.
POLL_INTERVAL=60s

# Сколько операций хранить. По базе листается история в боте, поэтому держать
# десяток нет смысла — она всё равно занимает килобайты.
HISTORY_LIMIT=1000

# Предельный возраст зачисления, о котором ещё стоит уведомлять. Банк отдаёт
# историю за месяц целиком, и без этого после простоя бот вывалил бы её всю.
# 0 — уведомлять о любых.
NOTIFY_MAX_AGE=24h

# ── Перевод себе (команда /pay) ─────────────────────────────────────────────
# Получатель зафиксирован здесь, а не в чате: даже с доступом к боту деньги
# нельзя увести никуда, кроме этого счёта. Из команды приходит только сумма.
# Перевод включается, только когда заданы и телефон, и банк.
#
# Каждый перевод подтверждается кодом из SMS — обойти это нельзя. Бот заполняет
# форму, а код вводите вы. Автоматизированные исходящие переводы — то, на что
# смотрит антифрод банка; это ваш риск (см. README).

TRANSFER_PHONE=
TRANSFER_BANK=
TRANSFER_COMMENT=

# Нижняя граница перевода. Задаётся банком: меньше десяти рублей СБП не
# проводит. Пусто — 10.
TRANSFER_MIN_AMOUNT=10

# Потолок одного перевода. Пусто или 0 — без ограничения.
TRANSFER_MAX_AMOUNT=

# Сколько ждать ответа человека по идущему переводу — сначала подтверждения
# финальной кнопки, потом кода из SMS, если банк его спросит.
TRANSFER_OTP_WAIT=3m

# Описание шагов формы перевода (см. transfer.example.json).
TRANSFER_STEPS_PATH=./transfer.json

# Боевой режим. Пока false — бот заполняет форму и ОСТАНАВЛИВАЕТСЯ перед
# отправкой: видно, что он ввёл, но деньги не уходят.
# Включайте true только когда заполнение выверено в черновом режиме.
# В боевом режиме бот всё равно спросит подтверждение в чате перед финальной
# кнопкой — на переводе себе банк кода не запрашивает, и это единственная
# точка, где человек решает.
TRANSFER_ARMED=false
